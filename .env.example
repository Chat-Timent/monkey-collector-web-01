# Copier en .env et remplir (le vrai .env n'est jamais commité).
# Base PostgreSQL locale du Raspberry Pi.
DATABASE_URL=postgresql://monkey:MOT_DE_PASSE@localhost:5432/monkey
# Pas de SSL par défaut (base locale). Mettre DATABASE_SSL=true pour une base distante.
# DATABASE_SSL=true
PORT=3000
# NODE_ENV=production est fourni par PM2 (cookies "secure", site servi en HTTPS).
